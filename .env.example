# ─────────────────────────────────────────────
# ITMS API — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to source control
# ─────────────────────────────────────────────

# ── Server ────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ── JWT Authentication ─────────────────────────
# MUST be changed before any deployment
JWT_SECRET=change-me-to-a-random-256-bit-secret
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

# ── PostgreSQL (future — not active in Phase 1) ─
DB_HOST=localhost
DB_PORT=5432
DB_NAME=itms_db
DB_USER=itms_user
DB_PASSWORD=change-me

# ── Redis (future — not active in Phase 1) ──────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Rate Limiting ──────────────────────────────
# 100 requests per 15 minutes per IP (default)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── Logging ───────────────────────────────────
# Levels: error | warn | info | debug
LOG_LEVEL=info
# Set to any non-empty string to enable debug output
DEBUG=

# ── CORS ──────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Error Tracking (future — optional) ────────
SENTRY_DSN=
